digraph bb1 {
  rankdir=TB;
  bgcolor="white";
  splines=true;
  nodesep=0.5;
  ranksep=0.9;
  node [fontname="Helvetica", fontsize=15, shape=box, style="filled", fillcolor="white", color="#333333", penwidth=1.4, margin="0.24,0.18"];
  edge [fontname="Helvetica", fontsize=12, color="#333333", penwidth=1.2];

  tapes  [label="4 tapes", shape=note, fillcolor="#eeeeee", fontsize=13];
  vsamd  [label="«external»\nVSAM data", fillcolor="#d9d9d9"];
  ctrl   [label="Migration\nController"];

  vsamr  [label="VSAM\nReader"];
  seg    [label="Segmentizer"];
  pack   [label="Packager"];
  rule   [label="Rule\nProcessor"];
  tsa    [label="Target\nSystem\nAdapter"];

  migdb  [label="Migration\ndatabase"];
  target [label="«external»\ntarget system", fillcolor="#d9d9d9"];

  { rank=same; tapes; vsamd; ctrl; }
  { rank=same; vsamr; seg; pack; rule; tsa; }
  { rank=same; migdb; target; }

  tapes -> vsamd [style=dashed, arrowhead=none, color="#888888"];

  vsamd -> vsamr [label="reads"];

  ctrl -> vsamr [style=dashed, label="calls"];
  ctrl -> seg   [style=dashed];
  ctrl -> pack  [style=dashed];
  ctrl -> rule  [style=dashed];

  vsamr -> migdb [style=dashed, label="conversion\nerrors"];
  seg   -> migdb [style=dashed, label="segmentation\nerrors"];
  pack  -> migdb [style=dashed, label="packaging\nerrors"];
  rule  -> migdb [style=dashed, label="rule\nerrors"];
  tsa   -> migdb [style=dashed, label="target\nerrors"];

  rule -> tsa [style=dashed];
  tsa  -> target [label="hands over"];
}

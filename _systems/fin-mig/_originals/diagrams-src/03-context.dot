digraph businesscontext {
  rankdir=LR;
  bgcolor="white";
  splines=true;
  nodesep=0.6;
  ranksep=1.5;
  node [fontname="Helvetica", fontsize=15, shape=box, style="filled", fillcolor="white", color="#333333", penwidth=1.4, margin="0.28,0.20"];
  edge [fontname="Helvetica", fontsize=13, color="#333333", penwidth=1.2];

  legacy [label="(legacy)\nmainframe system\n(VSAM data)"];
  mm     [label="Migration system\nM & M", fillcolor="#d9d9d9", penwidth=2.2];
  newsys [label="(new)\nclient/server system"];
  user   [label="User", shape=box, style="rounded,filled", fillcolor="white"];

  legacy -> mm [label="person data"];
  legacy -> mm [label="address data"];
  legacy -> mm [label="bank data"];
  legacy -> mm [label="account data"];

  mm -> user   [label="reports,\nstatistics"];
  mm -> newsys [label="(migrated)\naccount data"];

  { rank=same; user; newsys; }
}
